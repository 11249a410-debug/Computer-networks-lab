8:Experiment: Simulation of TCP and UDP using NS2
 
# File name: tcp_udp.tcl

# Step 1: Create a new simulator
set ns [new Simulator]

# Step 2: Create trace and NAM files
set tracefile [open tcp_udp.tr w]
$ns trace-all $tracefile

set namfile [open tcp_udp.nam w]
$ns namtrace-all $namfile

# Step 3: Define colors for NAM animation
$ns color 1 Blue
$ns color 2 Red

# Step 4: Define the simulation finish procedure
proc finish {} {
    global ns tracefile namfile

    $ns flush-trace

    close $tracefile
    close $namfile

    puts "----------------------------------"
    puts "TCP and UDP Simulation Completed"
    puts "Trace file: tcp_udp.tr"
    puts "NAM file: tcp_udp.nam"
    puts "----------------------------------"

    exit 0
}

# Step 5: Create four network nodes
set n0 [$ns node]
set n1 [$ns node]
set n2 [$ns node]
set n3 [$ns node]

# Step 6: Configure node labels for NAM
$n0 label "TCP Sender"
$n1 label "UDP Sender"
$n2 label "Router"
$n3 label "Receiver"

# Step 7: Create network links
# Syntax:
# duplex-link node1 node2 bandwidth delay queue_type

$ns duplex-link $n0 $n2 2Mb 10ms DropTail
$ns duplex-link $n1 $n2 2Mb 10ms DropTail
$ns duplex-link $n2 $n3 1Mb 20ms DropTail

# Step 8: Set queue limit on shared bottleneck link
$ns queue-limit $n2 $n3 20

# Step 9: Configure link directions in NAM
$ns duplex-link-op $n0 $n2 orient right-down
$ns duplex-link-op $n1 $n2 orient right-up
$ns duplex-link-op $n2 $n3 orient right

# -------------------------------------------------------
# Step 10: Configure TCP
# -------------------------------------------------------

# Create TCP sender agent
set tcp [new Agent/TCP]
$tcp set packetSize_ 1000
$tcp set fid_ 1

# Attach TCP sender to node 0
$ns attach-agent $n0 $tcp

# Create TCP receiver agent
set tcpSink [new Agent/TCPSink]

# Attach TCP receiver to node 3
$ns attach-agent $n3 $tcpSink

# Connect TCP sender and receiver
$ns connect $tcp $tcpSink

# Create FTP application over TCP
set ftp [new Application/FTP]
$ftp attach-agent $tcp

# -------------------------------------------------------
# Step 11: Configure UDP
# -------------------------------------------------------

# Create UDP sender agent
set udp [new Agent/UDP]
$udp set packetSize_ 512
$udp set fid_ 2

# Attach UDP sender to node 1
$ns attach-agent $n1 $udp

# Create UDP receiver agent
set null [new Agent/Null]

# Attach UDP receiver to node 3
$ns attach-agent $n3 $null

# Connect UDP sender and receiver
$ns connect $udp $null

# Create Constant Bit Rate traffic over UDP
set cbr [new Application/Traffic/CBR]
$cbr set packetSize_ 512
$cbr set interval_ 0.02
$cbr set random_ false

# Attach CBR application to UDP agent
$cbr attach-agent $udp

# Step 12: Schedule TCP and UDP traffic

# Start TCP traffic at 0.5 seconds
$ns at 0.5 "$ftp start"

# Start UDP traffic at 1.0 second
$ns at 1.0 "$cbr start"

# Stop UDP traffic at 4.0 seconds
$ns at 4.0 "$cbr stop"

# Stop TCP traffic at 4.5 seconds
$ns at 4.5 "$ftp stop"

# Finish simulation at 5.0 seconds
$ns at 5.0 "finish"

# Step 13: Start the simulation

puts "Starting TCP and UDP simulation..."
$ns run
